# Copy to .env (or .dev.vars) for `npm run dev`. wrangler dev reads either file. Never commit the copy.
# In production, set every value as a Worker secret (see README.md).

# GitHub OAuth app (login to the MCP server)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The only GitHub account that may log in (your GitHub user name). Without it nobody can log in.
ALLOWED_GITHUB_LOGIN=
COOKIE_ENCRYPTION_KEY=

# TUM mail (IMAP xmail.mwn.de, SMTP postout.lrz.de)
TUM_USER=
TUM_PASSWORD=
TUM_EMAIL=
TUM_DISPLAY_NAME=

# Zulip (zulip.cit.tum.de)
ZULIP_EMAIL=
ZULIP_API_KEY=

# TUMonline personal web services (optional, overrides the token stored by tumonline_request_token)
TUMONLINE_TOKEN=

# Moodle web service token (optional, without it Moodle uses a TUM SSO session with TUM_USER/TUM_PASSWORD)
MOODLE_TOKEN=

# Moodle without login: iCal export link (Kalender > Exportieren) and RSS key (Sicherheitsschlüssel)
MOODLE_CALENDAR_URL=
MOODLE_RSS_TOKEN=

# ITS scoreboard: your name as shown on the scoreboard (optional, for the "my rank" tool)
ITS_SCOREBOARD_NAME=
